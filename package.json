{
  "name": "tpay",
  "private": true,
  "version": "0.1.0",
  "description": "T.Pay OS/SaaS platform",
  "packageManager": "npm@11",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node dist/scripts/migrate.js",
    "test:postgres": "npm run build && node --test dist/tests/postgres-live.integration.test.js",
    "web:dev": "vite --config apps/web-renderer/vite.config.ts",
    "web:build": "vite build --config apps/web-renderer/vite.config.ts",
    "web:check": "npm run typecheck && npm run web:build",
    "web:test": "playwright test",
    "web:test:ui": "playwright test --ui"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "vite": "^7.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "@playwright/test": "^1.55.0"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}

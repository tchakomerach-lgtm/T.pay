{
  "name": "tpay",
  "private": true,
  "version": "0.1.0",
  "description": "T.Pay OS/SaaS platform",
  "packageManager": "npm@11",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "check": "npm run typecheck && npm test",
    "db:migrate": "node dist/scripts/migrate.js",
    "test:postgres": "npm run build && npm run db:migrate && TPAY_RUN_COMPARTMENT_INTEGRATION=1 TPAY_RUN_ADMIN_PAM_INTEGRATION=1 node --test dist/tests/postgres-live.integration.test.js dist/tests/admin-pam-capability.postgres.integration.test.js",
    "web:dev": "vite --config apps/education-web/vite.config.ts",
    "web:build": "vite build --config apps/education-web/vite.config.ts",
    "api:start": "npm run build && node dist/apps/api-server/src/main.js",
    "api:build": "npm run build",
    "api:seed:test": "npm run build && node dist/scripts/bootstrap-local-test.js",
    "test:terrain": "npm run check && npm run security:fortress && npm run test:postgres && node scripts/replit-terrain-certification.mjs",
    "security:fortress": "node scripts/security-fortress-check.mjs",
    "test:vault": "npm run build && node --test dist/tests/fortress-vault.test.js",
    "investor:dev": "vite --config apps/investor-demo/vite.config.ts",
    "investor:build": "vite build --config apps/investor-demo/vite.config.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}

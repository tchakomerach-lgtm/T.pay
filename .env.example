TPAY_DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/tpay
TPAY_DATABASE_SSL=require
TPAY_TLS_KEY_FILE=/absolute/path/to/tls/key.pem
TPAY_TLS_CERT_FILE=/absolute/path/to/tls/cert.pem
TPAY_API_HOST=0.0.0.0
TPAY_API_PORT=8443
TPAY_WEB_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
TPAY_REALTIME_QUEUE_LIMIT=100
